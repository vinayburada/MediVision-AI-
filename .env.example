# MediVision AI - Environment Configuration

# Google Gemini API Key (optional for basic classification and Grad-CAM, required for live LLM explanations)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501

# Model Configuration
DEFAULT_MODEL=densenet121
DEVICE=auto
MODEL_CHECKPOINT_DIR=artifacts/checkpoints

# Database Configuration
DATABASE_URL=sqlite:///database/medivision.db

# Storage Directories
UPLOAD_DIR=data/raw/uploads
PROCESSED_DIR=data/processed
REPORTS_DIR=artifacts/reports
PLOTS_DIR=artifacts/plots
